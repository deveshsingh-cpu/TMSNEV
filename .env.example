# GEMINI_API_KEY: Optional Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for this applet
APP_URL="http://localhost:3000"
PORT=3000

# Google Sheets Service Account Credentials
# Create a Service Account in Google Cloud Console, grant Google Sheets API access,
# and share the target Google Sheet with your Service Account email (Editor permissions).
GOOGLE_PROJECT_ID="your-gcp-project-id"
GOOGLE_CLIENT_EMAIL="transport-service-acc@your-gcp-project-id.iam.gserviceaccount.com"
# Store private key including -----BEGIN PRIVATE KEY----- and \n for line breaks
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# The ID from your spreadsheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID="your-google-sheet-id"

